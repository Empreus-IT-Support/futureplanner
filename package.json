{
  "name": "futureplanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:words": "node scripts/check-restricted-words.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check": "npm run check:words && npm run lint && tsc --noEmit && npm run test",
    "prebuild": "node scripts/check-deployable.mjs && vitest run --silent",
    "check:deployable": "node scripts/check-deployable.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
