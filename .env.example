# Enquiry form delivery.
#
# Copy to .env.local for development. Never commit real keys.
#
# Before launch, SPF, DKIM and DMARC must be configured on futureplanner.au and
# delivery tested to both a Gmail and an Outlook address. Form mail sent without
# authentication lands in spam.

# Transactional mail provider API key.
RESEND_API_KEY=

# Where enquiries are delivered.
ENQUIRY_TO=admin@futureplanner.au

# Envelope sender. Must be on a domain whose DNS you control and have
# authenticated, otherwise the mail will not be trusted.
ENQUIRY_FROM="Future Planner website <noreply@futureplanner.au>"

# Design preview only: renders every team profile so the layout can be
# reviewed before the written consents are back. A production build ignores
# this, so it cannot publish anyone by accident — shipping real profiles still
# means setting `consent: true` in data/team.ts.
NEXT_PUBLIC_PREVIEW_TEAM=false
