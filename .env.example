# Enquiry form delivery — via Atlas Control.
#
# Copy to .env.local for development. Never commit real keys.
#
# Atlas holds the provider credentials. The key below only works for one
# sending domain and only for the recipients allowlisted against it in
# Atlas (Client → Documentation → API → Atlas sending key), so a leaked key
# cannot be used to send anywhere else.
#
# The key is shown once when created and cannot be retrieved again.

ATLAS_SENDING_KEY=

# Where enquiries are delivered. Must be on the key's "Send only to" list in
# Atlas, or the send is refused.
ENQUIRY_TO=admin@futureplanner.au

# The registered sending address. Atlas rejects any other with a 403 — its
# integration example and error reference both name DoNotReply@ as the address
# to send as. "Name <addr>" is accepted; the bare address is extracted.
#
# Never put the visitor’s address here. It belongs in reply_to; sending as a
# domain Atlas is not authorised for fails DMARC and the mail is binned.
ENQUIRY_FROM="DoNotReply@futureplanner.au"

# Design preview only: renders every team profile so the layout can be
# reviewed before the written consents are back. A production build ignores
# this, so it cannot publish anyone by accident — shipping real profiles still
# means setting `consent: true` in data/team.ts.
NEXT_PUBLIC_PREVIEW_TEAM=false

# Search indexing. Left unset (or anything other than "true") the site sends
# robots.txt "Disallow: /" and a noindex meta tag on every page.
#
# This default is deliberate: until AVALONFS has approved the site and all six
# written consents are in, nothing here should be discoverable. A name or a
# photograph picked up by a crawler outlives the page it came from.
#
# Set to true in the Vercel project at launch, not before.
SITE_INDEXABLE=false
